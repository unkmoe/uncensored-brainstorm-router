{
  "name": "uncensored-brainstorm-router",
  "version": "0.1.0",
  "description": "Dual-question judge router for lawful uncensored LLM use: AUP refusal + friction-based escalation. Bundles the pi extension, an OpenAI-compatible HTTP core (src/core), a budget governor (src/governor), and a calibration battery.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "src",
    "pi-extensions",
    "calibration",
    "docs",
    "README.md",
    "AUP.md",
    "LICENSE",
    "tsconfig.json"
  ],
  "scripts": {
    "typegen": "openapi-typescript src/generated/openapi.json -o src/generated/schema.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "smoke": "tsx src/smoke.ts",
    "governor": "tsx src/governor/cli.ts",
    "core": "tsx src/core/server.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {}
}
